# Defaults for every run. Plain KEY=value. Any environment variable with the same name overrides it,
# e.g.  BUILD_CPU=4 ./jbp run
# Comments must be on their own line: anything after '=' is part of the value.
#
# ---- AWS / cluster (jbp up / down) ----
AWS_REGION=us-east-1
CLUSTER_NAME=jbp
# auto = newest EKS version in *standard* support (extended support bills $0.60/h instead of $0.10/h)
K8S_VERSION=auto
# `jbp up` drops any type the region doesn't offer in >= 2 zones (cluster.available_instance_types).
# Spot, 4 vCPU / 16 GiB class, several types so spot capacity is easy to find
INSTANCE_TYPES=m7a.xlarge,m6a.xlarge,m7i.xlarge,m6i.xlarge,m5.xlarge,m5a.xlarge
NODE_COUNT=1
NODE_DISK_GB=40
# Zone for the node group. EBS volumes are zonal: a spot replacement node in another zone could never
# attach the workspace PVC. empty = the first zone that offers every instance type.
NODE_AZ=

# ---- run (jbp run) ----
NAMESPACE=jbp
# Storage for the workspace PVC (k8s/pvc.yaml). Decision order: this value if set; else jbp-gp3 if that
# StorageClass exists (EKS); else the cluster default (kind: standard).
# empty = cluster default; on EKS `jbp all` uses the jbp-gp3 class that `jbp up` creates
STORAGE_CLASS=
PVC_SIZE=30Gi
# CPU limit drives build time: builds were throttled 59-89% at 2 CPUs on the first EKS run.
# build pod request = limit (Guaranteed QoS, like an OpenShift build pod)
BUILD_CPU=2
BUILD_MEM=4Gi
BUILD_TIMEOUT_S=1800
# >1 runs build Jobs side by side on the PVC's node: keep MAX_PARALLEL x BUILD_CPU under the node's CPUs.
# 1 = build repos strictly one by one
MAX_PARALLEL=1
# shared = ~/.m2 and GRADLE_USER_HOME on the PVC, reused across repos; none = cold builds
DEP_CACHE=shared
# extra build flags for optimisation runs, e.g. -T1C
MAVEN_ARGS_EXTRA=
GRADLE_ARGS_EXTRA=
# JVM flags for Maven itself (exported as MAVEN_OPTS in the build pod), e.g. -XX:TieredStopAtLevel=1
MAVEN_OPTS_EXTRA=
# ---- experiment switches (jbp experiment sets these per variant) ----
# on = add the Maven build-cache extension at build time, cache on the PVC (Maven repos only)
BUILD_CACHE=off
# leaf|root = append one line to a source file of the last|first mod-* module before building
BUILD_CACHE_EDIT=
# comma list of caches the orchestrator empties when a new run starts: deps (m2, m2-home, gradle), build
CLEAR_CACHE=
# Image for the orchestrator and collector pods: needs kubectl, git, python3 (and tar for kubectl cp).
ORCH_IMAGE=alpine/k8s:1.35.0
# AWS mirror of Docker official images (no Docker Hub rate limit). Set empty for Docker Hub.
IMAGE_REGISTRY=public.ecr.aws/docker/library/
# how long a pod may sit in ImagePullBackOff / Unschedulable before the build is failed early
IMAGE_PULL_GRACE_S=180
UNSCHEDULABLE_GRACE_S=600
CLONE_RETRIES=3

# ---- pricing for the report's cost estimate (USD, us-east-1; check before relying on it) ----
PRICE_EKS_HOUR=0.10
# typical m6a/m7a.xlarge spot; on-demand is ~0.17-0.23
PRICE_NODE_HOUR=0.07
PRICE_EBS_GB_MONTH=0.08
PRICE_IPV4_HOUR=0.005
