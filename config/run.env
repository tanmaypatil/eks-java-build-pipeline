# ---- AWS / cluster (bin/up.sh, bin/down.sh) ----
AWS_REGION="${AWS_REGION:-us-east-1}"
CLUSTER_NAME="${CLUSTER_NAME:-jbp}"
# Use a version in EKS *standard* support: extended support bills $0.60/h instead of $0.10/h.
K8S_VERSION="${K8S_VERSION:-auto}"       # auto = newest version AWS lists in standard support
# Spot, 4 vCPU / 16 GiB class, several types so spot capacity is easy to find
INSTANCE_TYPES="${INSTANCE_TYPES:-m7a.xlarge,m6a.xlarge,m7i.xlarge,m6i.xlarge,m5.xlarge,m5a.xlarge}"
NODE_COUNT="${NODE_COUNT:-1}"
NODE_DISK_GB="${NODE_DISK_GB:-40}"

# ---- run (bin/run.sh) ----
NAMESPACE="${NAMESPACE:-jbp}"
STORAGE_CLASS="${STORAGE_CLASS:-}"        # empty = cluster default; up.sh creates jbp-gp3 on EKS
PVC_SIZE="${PVC_SIZE:-30Gi}"
BUILD_CPU="${BUILD_CPU:-2}"               # build pod request = limit (OCP-like Guaranteed QoS)
BUILD_MEM="${BUILD_MEM:-4Gi}"
BUILD_TIMEOUT_S="${BUILD_TIMEOUT_S:-1800}"
MAX_PARALLEL="${MAX_PARALLEL:-1}"         # 1 = build repos strictly one by one
DEP_CACHE="${DEP_CACHE:-shared}"          # shared = ~/.m2 / GRADLE_USER_HOME on the PVC, reused across repos; none = cold
MAVEN_ARGS_EXTRA="${MAVEN_ARGS_EXTRA:-}"  # e.g. "-T1C" (phase 2 optimisations)
GRADLE_ARGS_EXTRA="${GRADLE_ARGS_EXTRA:-}"
ORCH_IMAGE="${ORCH_IMAGE:-alpine/k8s:1.35.0}"
IMAGE_REGISTRY="${IMAGE_REGISTRY-public.ecr.aws/docker/library/}"  # set to "" for Docker Hub

# ---- pricing for the report's cost estimate (USD, us-east-1, check before relying on it) ----
PRICE_EKS_HOUR="${PRICE_EKS_HOUR:-0.10}"
PRICE_NODE_HOUR="${PRICE_NODE_HOUR:-0.07}"      # typical m6a/m7a.xlarge spot; on-demand is ~0.17-0.23
PRICE_EBS_GB_MONTH="${PRICE_EBS_GB_MONTH:-0.08}"
PRICE_IPV4_HOUR="${PRICE_IPV4_HOUR:-0.005}"
