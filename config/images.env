# How an image is chosen (orchestrator.py pick_jdk + pick_image):
#   1. JDK = smallest entry in SUPPORTED_JDKS >= the Java version detect.py found (else the newest).
#   2. Family by build tool: Maven -> MAVEN_IMAGE_<jdk>; Gradle with gradlew -> JDK_IMAGE_<jdk>;
#      Gradle without a wrapper -> GRADLE_IMAGE_<jdk>.
# Adding a JDK = add it to SUPPORTED_JDKS and add all three keys (a unit test checks this).
# Build image per JDK. {registry} is replaced by IMAGE_REGISTRY from settings.env.
SUPPORTED_JDKS=11 17 21 25

# Maven projects (mvnw is honoured if present: it downloads the Maven version it pins)
MAVEN_IMAGE_11={registry}maven:3.9.11-eclipse-temurin-11
MAVEN_IMAGE_17={registry}maven:3.9.11-eclipse-temurin-17
MAVEN_IMAGE_21={registry}maven:3.9.11-eclipse-temurin-21
MAVEN_IMAGE_25={registry}maven:3.9.11-eclipse-temurin-25

# Gradle projects WITH gradlew: plain JDK, the wrapper fetches the pinned Gradle
JDK_IMAGE_11={registry}eclipse-temurin:11-jdk
JDK_IMAGE_17={registry}eclipse-temurin:17-jdk
JDK_IMAGE_21={registry}eclipse-temurin:21-jdk
JDK_IMAGE_25={registry}eclipse-temurin:25-jdk

# Gradle projects WITHOUT a wrapper
GRADLE_IMAGE_11={registry}gradle:8.14.3-jdk11
GRADLE_IMAGE_17={registry}gradle:8.14.3-jdk17
GRADLE_IMAGE_21={registry}gradle:8.14.3-jdk21
GRADLE_IMAGE_25={registry}gradle:9.2.1-jdk25
