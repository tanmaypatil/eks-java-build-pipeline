# Build images per JDK. Default registry is AWS ECR Public's mirror of Docker official images:
# no Docker Hub rate limit and in-region pulls from EKS. Swap to docker.io (drop the prefix) if needed.
REG="${IMAGE_REGISTRY-public.ecr.aws/docker/library/}"
SUPPORTED_JDKS="11 17 21 25"

# Maven projects (mvnw is honoured if present; it downloads the Maven version it pins)
MAVEN_IMAGE_11="${REG}maven:3.9.11-eclipse-temurin-11"
MAVEN_IMAGE_17="${REG}maven:3.9.11-eclipse-temurin-17"
MAVEN_IMAGE_21="${REG}maven:3.9.11-eclipse-temurin-21"
MAVEN_IMAGE_25="${REG}maven:3.9.11-eclipse-temurin-25"

# Gradle projects WITH gradlew: plain JDK, the wrapper fetches the pinned Gradle
JDK_IMAGE_11="${REG}eclipse-temurin:11-jdk"
JDK_IMAGE_17="${REG}eclipse-temurin:17-jdk"
JDK_IMAGE_21="${REG}eclipse-temurin:21-jdk"
JDK_IMAGE_25="${REG}eclipse-temurin:25-jdk"

# Gradle projects WITHOUT a wrapper
GRADLE_IMAGE_11="${REG}gradle:8.14.3-jdk11"
GRADLE_IMAGE_17="${REG}gradle:8.14.3-jdk17"
GRADLE_IMAGE_21="${REG}gradle:8.14.3-jdk21"
GRADLE_IMAGE_25="${REG}gradle:9.2.1-jdk25"
